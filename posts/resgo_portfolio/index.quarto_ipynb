        "        oil=Oil.default(),\n",
        "        oil_type_curve=OilTypeCurve.default(),\n",
        "        risk_profile=harsh_risk_profiles[\"Drift\"],\n",
        "    ),\n",
        "]\n",
        "\n",
        "bridge = Prospect(\n",
        "    name=\"Bridge\",\n",
        "    volumetric_model=VolumetricModel(\n",
        "        reservoirs=bridge_reservoirs,\n",
        "        dependency=0.5,\n",
        "    ),\n",
        "    field_development_model=FieldDevelopmentModel.simple_development(\n",
        "        num_producers=1,\n",
        "        reservoir_names=None,\n",
        "        start_date=datetime(2028, 1, 1),\n",
        "        month_offset=12,\n",
        "        drill_to_online_months=12,\n",
        "        max_oil_rate_stbpd=6_000,\n",
        "        producer_capex_USD=60e6,\n",
        "        years=30,\n",
        "    ),\n",
        "    economic_model=EconomicModel.from_values(\n",
        "        price_model=FlatPriceModel(oil_price_USD_stb=75.0, gas_price_USD_mmbtu=4.0),\n",
        "        royalty_model=FlatRoyaltyModel(royalty_rate=0.10),\n",
        "        tax_model=FlatTaxModel(tax_rate=0.30),\n",
        "        infrastructure_capex_USD=80e6,\n",
        "        annual_opex_USD=5e6,\n",
        "        producer_abandonment_cost_USD=1e6,\n",
        "        dry_hole_cost_USD=35e6,\n",
        "    ),\n",
        ")\n",
        "\n",
        "bridge_simpack = bridge.simulate(\n",
        "    risked=True,\n",
        "    levered=False,\n",
        "    chains=CHAINS,\n",
        "    draws=DRAWS,\n",
        "    seed=SEED,\n",
        ")\n",
        "\n",
        "bridge_reporter = ProspectReporter(prospect=bridge, simpack=bridge_simpack)"
      ],
