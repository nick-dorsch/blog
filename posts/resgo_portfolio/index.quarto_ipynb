    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "### Cove\n",
        "\n",
        "Cove is a small, low risk, single producer near field exploration opportunity that\n",
        "success at Buffet opens up.\n"
      ],
      "id": "202d48bd"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| output: false\n",
        "\n",
        "cove_area_km2 = (3.0, 6.0)\n",
        "\n",
        "cove_reservoirs = [\n",
        "    Reservoir(\n",
        "        area_km2=LogNormal.elicit(*cove_area_km2),\n",
        "        zone=zones[\"Archer\"],\n",
        "        oil=Oil.default(),\n",
        "        oil_type_curve=OilTypeCurve.default(),\n",
        "        risk_profile=risk_profiles[\"Archer\"],\n",
        "    ),\n",
        "    Reservoir(\n",
        "        area_km2=LogNormal.elicit(*cove_area_km2),\n",
        "        zone=zones[\"Boulder\"],\n",
        "        oil=Oil.default(),\n",
        "        oil_type_curve=OilTypeCurve.default(),\n",
        "        risk_profile=risk_profiles[\"Boulder\"],\n",
        "    ),\n",
        "    Reservoir(\n",
        "        area_km2=LogNormal.elicit(*cove_area_km2),\n",
        "        zone=zones[\"Canyon\"],\n",
        "        oil=Oil.default(),\n",
        "        oil_type_curve=OilTypeCurve.default(),\n",
        "        risk_profile=risk_profiles[\"Canyon\"],\n",
        "    ),\n",
        "    Reservoir(\n",
        "        area_km2=LogNormal.elicit(*cove_area_km2),\n",
        "        zone=zones[\"Drift\"],\n",
        "        oil=Oil.default(),\n",
        "        oil_type_curve=OilTypeCurve.default(),\n",
        "        risk_profile=risk_profiles[\"Drift\"],\n",
        "    ),\n",
        "]\n",
        "\n",
        "cove = Prospect(\n",
        "    name=\"Cove\",\n",
        "    volumetric_model=VolumetricModel(\n",
        "        reservoirs=cove_reservoirs,\n",
        "        dependency=0.5,\n",
        "    ),\n",
        "    field_development_model=FieldDevelopmentModel.simple_development(\n",
        "        num_producers=1,\n",
        "        reservoir_names=None,\n",
        "        start_date=datetime(2027, 1, 1),\n",
        "        month_offset=12,\n",
        "        drill_to_online_months=12,\n",
        "        max_oil_rate_stbpd=8_000,\n",
        "        producer_capex_USD=35e6,\n",
        "        years=30,\n",
        "    ),\n",
        "    economic_model=EconomicModel.from_values(\n",
        "        price_model=FlatPriceModel(oil_price_USD_stb=75.0, gas_price_USD_mmbtu=4.0),\n",
        "        royalty_model=FlatRoyaltyModel(royalty_rate=0.10),\n",
        "        tax_model=FlatTaxModel(tax_rate=0.30),\n",
        "        infrastructure_capex_USD=30e6,\n",
        "        annual_opex_USD=3e6,\n",
        "        producer_abandonment_cost_USD=1e6,\n",
        "        dry_hole_cost_USD=20e6,\n",
        "    ),\n",
        ")\n",
        "\n",
        "cove_simpack = cove.simulate(\n",
        "    risked=True,\n",
        "    levered=False,\n",
        "    chains=CHAINS,\n",
        "    draws=DRAWS,\n",
        "    seed=SEED,\n",
        ")\n",
        "\n",
        "cove_reporter = ProspectReporter(prospect=cove, simpack=cove_simpack)"
      ],
      "id": "66316d1d",
      "execution_count": null,
      "outputs": []
