      "source": [
        "### Bridge\n",
        "\n",
        "Bridge is a high risk and low reward prospect, with a single producer.\n"
      ],
      "id": "bb2bf218"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "## Set up harsher risk profiles\n",
        "\n",
        "harsh_risk_profiles = {\n",
        "    \"Archer\": RiskProfile.from_probs(\n",
        "        p_reservoir=0.92,\n",
        "        p_seal=0.95,\n",
        "        p_closure=0.96,\n",
        "        p_charge=0.10,\n",
        "    ),\n",
        "    \"Boulder\": RiskProfile.from_probs(\n",
        "        p_reservoir=0.88,\n",
        "        p_seal=0.93,\n",
        "        p_closure=0.97,\n",
        "        p_charge=0.10,\n",
        "    ),\n",
        "    \"Canyon\": RiskProfile.from_probs(\n",
        "        p_reservoir=0.94,\n",
        "        p_seal=0.90,\n",
        "        p_closure=0.95,\n",
        "        p_charge=0.10,\n",
        "    ),\n",
        "    \"Drift\": RiskProfile.from_probs(\n",
        "        p_reservoir=0.86,\n",
        "        p_seal=0.92,\n",
        "        p_closure=0.94,\n",
        "        p_charge=0.10,\n",
        "    ),\n",
        "}"
